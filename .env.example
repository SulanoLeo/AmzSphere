# Runtime: keep mock mode until a reviewed SP-API worker is deployed.
APP_ENV=development
AMZ_DATA_MODE=mock
MOCK_DB_PATH=./mock_db.json
LOG_LEVEL=INFO
POSTGRES_PASSWORD=

# Application security. Generate unique high-entropy values; never commit them.
APP_SECRET_KEY=
JWT_SIGNING_KEY=
CRON_SECRET=

# Persistence and asynchronous execution (production deployment targets).
# Require TLS for managed database and Redis endpoints.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/amzsphere
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=amzsphere-agent-actions
QUEUE_MAX_ATTEMPTS=8
QUEUE_VISIBILITY_TIMEOUT_SECONDS=120
SELLER_SYNC_INTERVAL_SECONDS=900

# Supabase alternative for the current Vercel mock deployment.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative; use one secret key variable, not both.
SUPABASE_SERVICE_ROLE_KEY=

# Amazon Login with Amazon (LWA) application credentials.
# Store production values in a secret manager, not in a checked-in env file.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
# Single-seller bootstrap alias; production refresh tokens belong encrypted per seller in PostgreSQL.
SP_API_REFRESH_TOKEN=
SP_API_APPLICATION_ID=
SP_API_APPLICATION_VERSION=

# Selling Partner API seller, marketplace, endpoint, and signing region.
SP_API_SELLER_ID=
BOOTSTRAP_TENANT_ID=
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
SP_API_AWS_REGION=us-east-1
SP_API_ROLE_ARN=
# Prefer workload identity/role assumption. Leave static credentials empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Ads API is a separate application/authorization from SP-API.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_ENDPOINT=https://advertising-api.amazon.com

# AI and external search-data providers. Never expose these to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30
SERPAPI_API_KEY=
HELIUM10_API_KEY=
SERP_PROVIDER_API_KEY=
SERP_PROVIDER_BASE_URL=

# Production application switches. Remain disabled until approval, auth, and credentials are configured.
SP_API_ENABLED=false
SP_API_DRY_RUN=true
FERNET_KEY=
PLATFORM_API_KEY=
OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/amazon/callback
WEB_APP_URL=http://localhost:3000
PO_OUTPUT_DIR=./var/purchase-orders

# Next.js BFF: OAuth provider (Google/Gmail) and user allowlist. The backend key is server-only.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
WEB_ALLOWED_EMAILS=
WEB_APPROVER_EMAILS=
AMZSPHERE_BACKEND_URL=http://localhost:8001
AMZSPHERE_PLATFORM_API_KEY=
AMAZON_NOTIFICATIONS_SQS_URL=