{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/api/(health|v1/.*)",
      "dest": "/api/index.py",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-admin-secret, x-workspace-user, x-amz-sns-message-signature, Idempotency-Key"
      }
    },
    {
      "src": "/(.*)",
      "dest": "web"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/amazon-writes/execute",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/procurement/pdf/compile-batch",
      "schedule": "0 1 * * *"
    }
  ]
}